// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String         @id @default(cuid())
  // Identité gérée par Clerk (fournisseur d'auth) ; nullable le temps que les comptes
  // pré-existants se reconnectent et se lient (voir lib/auth/session.ts, syncUser()).
  clerkId       String?        @unique
  email         String         @unique
  name          String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())

  isBanned        Boolean @default(false)
  sendDisabled    Boolean @default(false)
  sendLimitCount  Int?
  sendLimitPeriod String? // "day" | "week" | "month"

  // Second facteur de l'espace admin (mot de passe dédié) : flag à expiration courte,
  // remplace l'ancien Session.isAdminUnlocked maintenant que Clerk gère les sessions.
  adminUnlockedUntil DateTime?

  gmailAccounts GmailAccount[]
  templates     Template[]
  sentEmails    SentEmail[]
  apiKeys       ApiKey[]
  services      Service[]
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String // préfixe affiché dans l'UI (la clé en clair n'est jamais stockée)
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model GmailAccount {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  type         String // "oauth" | "smtp"
  displayName  String?
  refreshToken String? // encrypted (oauth) — absent quand clerkUserId est renseigné
  accessToken  String? // encrypted (oauth)
  tokenExpiry  DateTime?
  // Renseigné pour le compte auto-connecté à l'inscription via le scope gmail.send
  // demandé par Clerk : le token d'accès est alors récupéré à la demande auprès de
  // Clerk (qui gère le refresh) plutôt que stocké/déchiffré nous-mêmes.
  clerkUserId  String?
  appPassword  String? // encrypted (smtp)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sentEmails   SentEmail[]
  services     Service[]

  @@unique([userId, email])
}

model Service {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  serviceId      String       @unique // identifiant exposé, choisi par l'utilisateur (pré-rempli depuis le nom)
  gmailAccountId String
  gmailAccount   GmailAccount @relation(fields: [gmailAccountId], references: [id])
  createdAt      DateTime     @default(now())
}

model Template {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  subject    String
  body       String
  variables  String      @default("[]") // JSON array of variable names
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  sentEmails SentEmail[]
}

model SentEmail {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailAccountId String
  gmailAccount   GmailAccount @relation(fields: [gmailAccountId], references: [id])
  templateId     String?
  template       Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipient      String
  subject        String
  body           String
  status         String // "sent" | "failed"
  error          String?
  sentAt         DateTime @default(now())
}

// Historique du chatbot IA de /docs, consultable par l'admin (support/qualité des
// réponses). sessionId regroupe les messages d'une même conversation côté navigateur
// (pas de compte utilisateur : la doc est accessible sans connexion).
model DocsChatConversation {
  id        String            @id @default(cuid())
  sessionId String            @unique
  ip        String?
  locale    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  messages  DocsChatMessage[]
}

model DocsChatMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   DocsChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime             @default(now())
}
